<div class="container container-for-chat">
  <div class="sidebar">
    <div class="pb-3">
      <button class="btn border new-chat w-100 border-dark" id="new-chat">
        <%= t("views.chat.new_chat") %>
        <i class="fa-solid fa-plus"></i></button>
      <input type="hidden" id="prompt-id" value="<%= @prompt_id %>">
      <input type="hidden" id="project-id" value="<%= @project_id %>">
    </div>
    <div class="chatbox-container custom-scrollbar" data-chat-current="<%= @current_chat&.public_uid %>">
      <% @user_history_chat&.each do |chat| %>
      <div class="chatbox-item <%= @current_chat&.public_uid == chat.public_uid ? 'chat-active' : ''%>"
        data-id-chat="<%= chat.public_uid %>">
        <i class="fa-solid fa-message"></i>
        <div class="chatbox-name ms-2"><%= chat.chat_name%></div>
        <input type="text" name="rename" class="chatbox-rename mx-2" placeholder="Enter a name">
        <div class="flex function-action" data-action="change-chat">
          <i class="fa-solid fa-pen edit-chat mx-1"></i>
          <i class="fa-solid fa-trash-can mx-1 remove-chat"></i>
          <i class="fa-solid fa-check mx-1 save-name-chat d-none"></i>
          <!-- <i class="fa-solid fa-xmark mx-1 close-edit-chat d-none"></i> -->
        </div>
      </div>
      <% end %>
    </div>
    <div class="version-chat">
      <span class="version"><%= @current_chat&.default_models&.upcase%></span>
    </div>
  </div>
  <div class="content">
    <div class="chat-container" data-controller="chat-gpt">
      <div class="chat-messages" id="chat-messages">
        <% if @user_chat_content.present? %>
          <% @user_chat_content&.each do |mess|%>
          <div class="user-message" id="user-message"><span>👤</span><%= mess&.dig('user_request') %></div>
          <div class="ai-message" id="ai-message">
          </div>
          <% end %>
        <% else %>
          <div class="select-model">
            <ul class="d-flex justify-content-center align-items-center list-unstyled model-list">
              <li>
                <button type="button" class="btn btn-outline-secondary mx-2 btn-model
                  <%= @current_chat&.default_models == 'gpt-3.5-turbo' ? 'active-model' : ''%>" data-model="gpt-3.5-turbo">
                  <i class="fa-solid fa-check"></i>
                  GPT-3.5
                </button>
              </li>
              <li>
                <button type="button" class="btn btn-outline-secondary mx-2 btn-model
                <%= @current_chat&.default_models == 'gpt-4' ? 'active-model' : ''%>" data-model="gpt-4">
                <i class="fa-solid fa-check"></i>
                GPT-4
                </button>
              </li>
            </ul>
          </div>
          <div class="w-75 chat-example m-auto">
            <div class="example-logo d-flex justify-content-center align-items-center">
              <%= image_tag "logo.png", class: "image-logo" %>
            </div>
            <span class="d-flex justify-content-center align-items-center pt-2 pb-4"><h3><%= t("views.chat.example") %></h3></span>
            <%= render 'chat/example' %>
          </div>
        <% end %>
      </div>
      <hr />
      <div class="action-chat">
        <span>
          <%= form_with(url: '#', format: :js, local: false, multipart: true) do |f| %>
            <span id="file-name"></span>
            <%= f.label :name, class: "btn border" do %>
              <i class="fas fa-file-upload"></i> Upload
              <%= f.file_field :name, style: 'display: none;', onchange: 'displayFileName(this)' %>
            <% end %>
          <% end %>
        </span>
        <a href="<%= download_chat_path(token: @current_chat&.public_uid, format: :csv) %>">
          <button class="btn border download-csv mx-2" id="download-csv">
            <i class="fas fa-file-download"></i>
            <%= t("views.chat.download") %>
          </button>
        </a>
        <button class="mt- 2 btn border regenerate-btn mx-2" id="scroll-button"><i class="fa-solid fa-rotate"></i>
          <%= t("views.chat.regenerate_message") %></button>
        <button class="btn border stop-regenerate-btn mx-2 d-none" id="scroll-button"><i class="fa-solid fa-stop"></i>
          <%= t("views.chat.stop_general_chat") %></button>
        <button class="btn border scroll-bottom" id="scroll-button"><i class="fa-solid fa-arrow-down"></i></button>
      </div>
      <div class="user-input-container">
        <div class="input-wrapper">
          <textarea class="form-control" type="text" id="user-input" placeholder="<%= t("views.chat.typing_message") %>..."></textarea>
        </div>
        <div class="waiting-response load-wrapp d-none">
          <div class="load-3">
            <div class="line"></div>
            <div class="line"></div>
            <div class="line"></div>
          </div>
        </div>
        <button id="send-button"><i class="fas fa-paper-plane"></i></button>
      </div>
    </div>
  </div>
</div>


<div class="modal fade" id="remove-chat" tabindex="-1" aria-labelledby="removeChatModal" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="removeChatModal"><%= t("views.chat.remove_chat") %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= t("views.chat.remove_chat_content") %>
      </div>
      <div class="modal-footer justify-content-center">
        <button type="button" class="btn btn-secondary mx-2" data-bs-dismiss="modal"><%= t("views.button.cancel") %></button>
        <button type="button" class="btn btn-primary mx-2 confirm-delete-chat" data-bs-dismiss="modal">Ok</button>
      </div>
    </div>
  </div>
</div>
<script>
  function displayFileName(input) {
    var fileName = input.files[0].name;
    document.getElementById('file-name').innerHTML = fileName;
  }
  document.addEventListener("DOMContentLoaded", function () {
    hljs.initHighlightingOnLoad();
    const currentUrl = $(".chatbox-container").data('chat-current');

    function addBotMessageWithTypingEffect(dom, message) {
      var md = window.markdownit({
        html: true,
        linkify: true,
        typographer: true,
        breaks: false,
        langPrefix: 'language-',
        highlight: function (str, lang) {
          if (lang && hljs.getLanguage(lang)) {
            try {
              return '<pre class="hljs p-2 position-relative"><code>' +
                hljs.highlight(str, {
                  language: lang,
                  ignoreIllegals: true
                }).value +
                '</code> <button class="hljs-copy hljs-copy-button">Copy</button>' +
                '<button class="copy-done d-none btn"><i class="fa-solid fa-check"></i> Copied!</button></pre>';
            } catch (__) {}
          }
          return '<pre class="hljs"><code>' + md.utils.escapeHtml(str) + '</code></pre>';
        }
      })

      var html = md.render('<p><span>🤖</span>' + message + '</p>');
      dom.innerHTML = html;
    }

    $.ajax({
      url: `/chat_history`,
      data: {
        token: currentUrl
      },
      beforeSend: (xhr) => {
        const csrfToken = document.querySelector(
          "meta[name='csrf-token']"
        ).content;
        xhr.setRequestHeader("X-CSRF-Token", csrfToken);
      },
      type: "GET",
      dataType: "json"
    })
    .done(function (response) {
      const { chat_history } = response;
      const aiRpList = document.querySelectorAll('#ai-message');
      aiRpList.forEach((i, idx) => {
        addBotMessageWithTypingEffect(i, chat_history[idx])
      });
    })
    .fail(function (error) {
      console.log("error", error);
    });
  });
</script>
