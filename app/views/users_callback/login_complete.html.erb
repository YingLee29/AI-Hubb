<div style="display: flex; justify-content: center; transform: translate(0, 50vh);">
  <span>Processing Authentication...</span>
</div>
<script>
  window.addEventListener("DOMContentLoaded", (event) => {
    const root_path = "<%= @response&.dig(:root_path) %>";
