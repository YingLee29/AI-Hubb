<% breadcrumb :playground %>
<% provide(:title, "Local Playground") %>
<div class="container-xxl flex-grow-1 container-p-y pt-5" data-controller="prompt-detail" >
  <div class="row playground">
    <div class="sidebar col-3">
      <div class="pb-3">
        <button class="btn border new-playground w-100 border-dark" id="new-playground">
          <%= t("views.playground.new_playground") %>
          <i class="fa-solid fa-plus"></i></button>
      </div>
      <div class="chatbox-container custom-scrollbar" data-playground-current="<%= @prompt&.public_uid %>">
        <% @user_playground&.each do |playground| %>
        <div class="chatbox-item <%= @prompt&.public_uid == playground.public_uid ? 'chat-active' : ''%>"
          data-id-prompt="<%= playground.public_uid %>">
          <div class="chatbox-name ms-2"><%= playground.name%></div>
          <input type="text" name="rename" class="chatbox-rename mx-2" placeholder="Enter a name">
          <div class="flex function-action" data-action="change-playground">
            <i class="fa-solid fa-pen edit-playground mx-1"></i>
            <i class="fa-solid fa-trash-can mx-1 remove-playground"></i>
            <i class="fa-solid fa-check mx-1 save-name-playground d-none"></i>
            <!-- <i class="fa-solid fa-xmark mx-1 close-edit-playground d-none"></i> -->
          </div>
        </div>
        <% end %>
      </div>
    </div>
    <%= form_with url: playground_run_test_path,
      class: "pb-5 form-inline prompt-form row col-9",
      local: true,
      id: 'prompt-form',
      html: { autocomplete: "off" },
      data: { prompt: @prompt&.to_param },
      method: :patch do |f| %>
      <div class="row">
        <div class="prompt-container col-9 row">
          <%= render partial: 'playground_prompt/playground_show'%>
        </div>
        <div class="col-3 content-col-prompt">
          <div class="mb-2">
            <label for="gpt">GPT</label>
            <select class="form-select custom-select" aria-label="Default select example">
              <option selected>OpenAI</option>
            </select>
          </div>
          <div class="mb-2">
            <label for="api">API</label>
            <%= f.select(:ai_api_id, @ai_apis.pluck(:name, :public_uid),
              { selected: @prompt.present? ? @prompt.ai_api.to_param : @ai_apis.last.to_param },
              { :class => "form-select custom-select select-api change-api", :id => "formtabs-country", data: { update_api_type_url: playground_update_api_type_path, prompt_id: @prompt.to_param , api_type: @prompt&.ai_api&.ai_type } })
            %>
          </div>
          <div class="mb-2 select-model-prompt">
            <%= render partial: 'prompts/select_model'%>
          </div>
          <div class="form-inline parameter parameter-list">
            <%= render partial: 'prompts/parameter'%>
          </div>
        </div>
      </div>
    <% end %>
    <div class="d-grid gap-2 mt-4 btn-run-test d-flex flex-row-reverse">
      <button id="test-playground" data-action="test-playground" data-id="<%= @prompt&.to_param %>" class="btn btn-primary me-2 py-2 px-4 fw-bold" type="button" <%= @prompt.present? ? ' ' : 'disabled' %>><%= t("views.prompt.test") %></button>
    </div>
  </div>
  <div class="loader d-none">
    <div class="loader-circle"></div>
    <span class="loader-text">Loading...</span>
  </div>
</div>
<div class="modal fade" id="remove-playground" tabindex="-1" aria-labelledby="removePlaygroundModal" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="removePlaygroundModal"><%= t("views.playground.remove_playground") %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= t("views.playground.remove_playground_content") %>
      </div>
      <div class="modal-footer justify-content-center">
        <button type="button" class="btn btn-secondary mx-2" data-bs-dismiss="modal"><%= t("views.button.cancel") %></button>
        <button type="button" class="btn btn-primary mx-2 confirm-delete-playground" data-bs-dismiss="modal">Ok</button>
      </div>
    </div>
  </div>
</div>
<script>
  window.scroll({
    top: 0,
    left: 0,
    behavior: "smooth",
  });
</script>
