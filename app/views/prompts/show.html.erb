<% breadcrumb :prompt, @prompt %>
<% provide(:title, t("views.prompt.prompt_ai_setting")) %>
<section data-controller="home" class="section-prompt">
  <div class="container-xxl pt-5 controller-action" data-controller="prompt-detail">
    <ul class="nav nav-tabs" role="tablist">
      <li class="nav-item">
        <a class="nav-link active" data-bs-toggle="tab" href="#playground"><%= t("views.prompt.playground")%></a>
      </li>
      <% if @prompt.is_chat_completions? %>
        <li class="nav-item">
          <a class="nav-link" data-bs-toggle="tab" href="#chat"><%= t("views.prompt.chat")%></a>
        </li>
      <% end %>
      <li class="nav-item">
        <a class="nav-link" data-bs-toggle="tab" href="#apicall"><%= t("views.prompt.api_key")%></a>
      </li>
      <% if check_admin %>
        <li class="nav-item">
          <a class="nav-link" data-bs-toggle="tab" href="#log"><%= t("views.prompt.log")%></a>
        </li>
      <% end %>
    </ul>

    <!-- Tab panes -->
    <div class="tab-content">
      <div id="playground" class="container tab-pane active"><br>
        <div>
          <div class="d-flex justify-content-between align-items-center" style="<%= check_admin ? '' : 'padding-bottom: 40px' %>">
            <div class="pb-3">
              <h4 class="mb-0 fw-6"><%= t("views.prompt.prompt_ai_setting")%></h4>
            </div>
          </div>
          <%= render partial: 'playground_prompt/playground_prompt' %>
          <%# <div class="row row-custom">
            <div class="border px-3" style="width: 100%">
              <%= render partial: 'prompt_data'%>
            <%# </div>
          </div> %>
        </div>
      </div>
      <div id="chat" class="container tab-pane fade"><br>
        <h4 style="padding-bottom: 40px">Prompt Chat</h4>
        <%= render partial: 'chat/chat_page' %>
      </div>
      <div id="apicall" class="container tab-pane fade"><br>
        <h4 style="padding-bottom: 40px"><%= t("views.prompt.key.key_management")%></h4>
        <div class="row row-custom py-3">
          <%= render partial: 'api_example'%>
        </div>
        <%= render 'keys/key_session', keys: @keys, prompt: @prompt %>
      </div>
      <div id="log" class="container tab-pane fade"><br>
        <h4 style="padding-bottom: 40px">Prompt Log</h4>
        <div>
          <%= render partial: 'logs/logs_page', locals: { url: url_for(project_prompt_path(current_project, @prompt)) + '#log' } %>
        </div>
      </div>
    </div>
  </div>
  <%= render partial: 'save_and_test_modal'%>
  <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="listModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="listModalLabel">Delete Prompt</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          Do you want to delete this prompt now?
        </div>
        <div class="modal-footer justify-content-center">
          <button type="button" class="btn btn-secondary mx-2" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary mx-2" data-bs-dismiss="modal">Ok</button>
        </div>
      </div>
    </div>
  </div>
</section>
<div id="toastsContainerTopRight" class="toasts-top-right fixed toasts-copy__url toast-custom d-none">
  <div class="bs-toast toast toast-ex animate__animated my-2" role="alert" aria-live="assertive" aria-atomic="true"
    data-bs-delay="2000">
    <div class="toast-header d-flex justify-content-start">
      <div class="toast-body"></div>
    </div>
  </div>
</div>
<script>
  window.addEventListener("DOMContentLoaded", (event) => {
    function getALLTagFromUserInput() {
      var parameterList = [];
      const listContent = document.querySelectorAll("#messages_params_content");
      const listMessageParName = document.querySelectorAll(
        "#messages_params_name"
      );
      const listMessageParFunC = document.querySelectorAll(
        "#messages_params_function_call"
      );
      const listFunctionName = document.querySelectorAll(
        "#functions_params_name"
      );
      const listFunctionDes = document.querySelectorAll(
        "#functions_params_description"
      );
      const listFunctionPar = document.querySelectorAll(
        "#functions_params_parameters"
      );
      const listParamsPrompt = document.querySelectorAll(
        ".completion_prompt_param"
      );
      listMessageParName.forEach(function (i) {
        var value = $(i).val();
        parameterList.push(value);
      });
      listMessageParFunC.forEach(function (i) {
        var value = $(i).val();
        parameterList.push(value);
      });
      listFunctionName.forEach(function (i) {
        var value = $(i).val();
        parameterList.push(value);
      });
      listFunctionDes.forEach(function (i) {
        var value = $(i).val();
        parameterList.push(value);
      });
      listFunctionPar.forEach(function (i) {
        var value = $(i).val();
        parameterList.push(value);
      });
      listContent.forEach(function (i) {
        var value = $(i).val();
        parameterList.push(value);
      });
      listParamsPrompt.forEach(function (i) {
        var value = $(i).val();
        parameterList.push(value);
      });
      return parameterList;
    }
    if ($(".change-api").attr("data-api-type") == 'image_generation' || $(".change-api").attr("data-api-type") == 'image_edit') {
      $('textarea#prompt').attr('placeholder','Enter text with maximum of length is 1000 characters');
      $('.n').attr('placeholder','Must be an integer between 1 and 10');
    } else {
      const inputPlaceholder = "<%= t("views.prompt.enter_content")%>"
      $('textarea#prompt').attr('placeholder', inputPlaceholder);
      $('.n').attr('placeholder','Must be an integer');
    }
    $('.top_p').attr('placeholder','Must be positive number and less than or equal to 1');
    $('.temperature').attr('placeholder','Must be positive number and less than or equal to 2');
    $('.stream').attr('placeholder','Must be boolean (true or false)');
    $('.logprobs').attr('placeholder','Must be positive integer and less than 5');
    $('.max_tokens').attr('placeholder',`Must be positive integer and less than ${$(".select-model").attr("data-max-tokens")} with current model`);
    $('.input').attr('placeholder','Enter input');
    $('.instruction').attr('placeholder','Enter instruction');
    let tagInput = [];
    const userTyping = getALLTagFromUserInput()?.join(" ");
    const content = userTyping || '';
    let tags = content?.match(/<([^>]+)>/g)?.map((tag) => tag.slice(1, -1));
    let uniqueTags = Array.from(new Set(tags));
    // handle Ctrl+Enter
  function handleSendMessageWithKeyBoard(dom) {
    var inputElements = document.querySelectorAll(dom);
    inputElements.forEach(function(inputElement) {
      inputElement.addEventListener('keydown', function(event) {
        if (event.ctrlKey && event.keyCode === 13) {
          event.preventDefault();
          $("#test-prompt").click()
        }
      });
    });
  }
    if (uniqueTags && uniqueTags.length > 0) {
      var elements = document.querySelectorAll(".input-tag-complete");
      elements.forEach(function(element) {
        element.remove();
      });
      uniqueTags.forEach((i, idx) => {
        $(".tag-added").append(`
          <div class="m-2 input-tag-complete form-group" style="width: 95%;">
            <label class="text-truncate w-100" for="userTagInput">${uniqueTags[idx]}:</label>
            <textarea class="form-control" type="text" id="userTagInput" value="${ tagInput[idx] != undefined ? tagInput[idx] : ""}" rows="3"></textarea>
          </div>
        `)
      });
    } else {
      $(".input-tag-complete").remove();
    }
    let textarea = document.querySelectorAll("#userTagInput");
    textarea.forEach((i, idx) => {
      tagInput[idx] = i.value;
      i.addEventListener("keyup", function () {
        tagInput[idx] = i.value.trim();
      });
    });
      handleSendMessageWithKeyBoard('textarea[id="userTagInput"]');
  });
  const tabLinks = document.querySelectorAll('[data-bs-toggle="tab"]');
  tabLinks.forEach(tabLink => {
    tabLink.addEventListener('shown.bs.tab', (event) => {
      const href = event.target.getAttribute('href');
      history.pushState({}, '', href);
    });
  });
  const urlAnchor = window.location.hash;
    if (urlAnchor !== "" && urlAnchor.startsWith("#")) {
      const tabLink = document.querySelector(`[data-bs-toggle="tab"][href="${urlAnchor}"]`);
      if (tabLink) {
        const tab = new bootstrap.Tab(tabLink);
        tab.show();
      }
    }
</script>
