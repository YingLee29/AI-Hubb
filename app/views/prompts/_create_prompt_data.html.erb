<%= form_with url: project_prompts_path,
  class: 'form-inline px-4 py-3 prompt-form',
  local: true,
  id: 'prompt-form',
  html: { autocomplete: "off" },
  remote: true,
  method: :post do |f| %>
  <div class="form-inline d-flex align-items-center my-4">
    <label class="me-3 form-label" style="width: 60px;" for="api-url">Project</label>
    <input class="form-control custom-input" value="<%= @current_project&.name %>" disabled="disabled" type="text">
  </div>
  <div class="form-inline d-flex align-items-center">
    <label class="me-3 form-label" style="width: 60px; min-width: 60px" for="prompt">Name <span style="color: red">*</span></label>
    <div class="w-100">
        <%= f.text_field :name,
        class: "form-control custom-input",
        id: "prompt_name",
        :value => "",
        maxlength: "255",
        placeholder: 'Input Prompt Name',
        :required => true
      %>
      <div class="prompt-name-blank"><span class="error-name-content" style="color: red"></span></div>
    </div>
  </div>
  <div class="form-inline d-flex align-items-center my-4">
    <label class="me-3 form-label" style="width: 60px;" for="gpt">GPT</label>
    <select class="form-select custom-select" aria-label="Default select example">
      <option selected>OpenAI</option>
    </select>
  </div>
  <div class="form-inline d-flex align-items-center">
    <label class="me-3 form-label" style="width: 60px;" for="api">API</label>
    <%= f.select(:ai_api_id, @ai_apis.pluck(:name, :public_uid),
      { selected: @init_api&.to_param || @ai_apis.last&.to_param },
      { :class => "form-select custom-select select-api change-api", :id => "formtabs-country", data: { url: new_project_prompt_path,
        update_api_type_url: update_api_type_project_prompts_path(project_id: @current_project.to_param) , api_type: @init_api&.ai_type } }) %>
  </div>
  <div class="form-inline d-flex align-items-center my-4">
    <div class="form-inline d-flex align-items-center my-4 select-model-prompt">
      <%= render partial: 'create_select_model'%>
    </div>
  </div>
  <div class="form-inline parameter parameter-list">
    <%= render partial: 'parameter'%>
  </div>
  <div class="form-inline config-api">
    <div class="form-inline d-flex align-items-center my-4 application-domain">
      <label class="me-3 form-label" style="width: 300px;" for="domain">Description</label>
      <div class="w-100">
      <%= f.text_area :description, class: 'form-control', placeholder: 'Enter description', rows: 3 %>
      </div>
    </div>
    <div class="form-inline d-flex align-items-center my-4 application-domain prompt">
      <label class="me-3 form-label" style="width: 300px;" for="domain">Application Domain</label>
      <div class="w-100">
        <%= text_field_tag'', @prompt.present? ? @prompt.application_domain : '', class: 'form-control disable-fields', disabled: true %>
      </div>
    </div>
    <div class="form-inline d-flex align-items-center">
      <label class="me-3 form-label" style="width: 300px;" for="api-endpoint">Application endpoint name <span style="color: red">*</span></label>
        <div class="w-100">
          <%= f.text_field :endpoint_name,
            class: "form-control",
            id: "endpoint_name",
            placeholder: 'Enter endpoint name',
            :value => "",
            maxlength: "255",
            :required => true
          %>
          <div class="endpoint_name-blank"><span class="error-endpoint_name-content" style="color: red"></span></div>
        </div>
    </div>
    <div class="form-inline d-flex align-items-center my-4 prompt">
      <label class="me-3 form-label" style="width: 300px;" for="api-url">API endpoint URL</label>
      <%= f.text_field :endpoint_url,
          class: "form-control disable-fields",
          id: "endpoint_url",
          :value => "",
          placeholder: 'API Endpoint URL will be auto-generate when enter endpoint name',
          data: {
            domain: ENV['DOMAIN_API']
          }
        %>
        <button type="button" class="copy-url__endpoint me-2 btn p-0"
          data-message-copy="copy endpoint URL"
        >
          <i class="far fa-copy color-copy"></i>
        </button>
    </div>
    <div class="d-flex align-items-center justify-content-center my-3">
      <%= link_to 'Cancel', project_prompts_path, class: 'btn btn-outline-secondary mx-4' %>
      <button id="create-prompt" class="btn btn-primary me-4">Save</button>
    </div>
  </div>
<% end %>
