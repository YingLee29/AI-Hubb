<%= form_with url: project_prompt_path(@current_project, @prompt),
  class: "form-inline px-4 py-3 prompt-form #{ user_project_role ? 'prompt-form-role-check' : '' }",
  local: true,
  id: 'prompt-form',
  html: { autocomplete: "off" },
  data: { prompt: @prompt&.to_param },
  method: :patch do |f| %>
  <div class="form-inline d-flex align-items-center my-4">
    <label class="me-3 form-label" style="width: 60px;" for="api-url">Project</label>
    <input class="form-control custom-input" value="<%= @current_project&.name %>" disabled="disabled" type="text">
  </div>
  <div class="form-inline d-flex align-items-center prompt-name">
    <label class="me-3 form-label" style="width: 60px; min-width: 60px" for="prompt">Name <span style="color: red">*</span></label>
    <div class="w-100">
        <%= f.text_field :name,
        class: "form-control custom-input",
        id: "prompt_name",
        :value => @prompt.present? ? @prompt.name : "",
        placeholder: 'Input Prompt Name',
        :required => true
      %>
      <div class="error-name-content" style="color: red"></span></div>
    </div>
  </div>
  <div class="form-inline d-flex align-items-center my-4">
    <label class="me-3 form-label" style="width: 60px;" for="gpt">GPT</label>
    <select class="form-select custom-select" aria-label="Default select example">
      <option selected>OpenAI</option>
    </select>
  </div>
  <div class="form-inline d-flex align-items-center">
    <label class="me-3 form-label" style="width: 60px;" for="api">API</label>
    <%= f.select(:ai_api_id, @ai_api.pluck(:name, :public_uid),
      { selected: @prompt.present? ? @prompt.ai_api.to_param : @ai_api.last.to_param },
      { :class => "form-select custom-select select-api change-api", :id => "formtabs-country", data: {
        update_api_type_url: update_api_type_project_prompts_path(project_id: @current_project.to_param) , api_type: @prompt.ai_api&.ai_type } }) do %>
  </div>
  <div class="form-inline d-flex align-items-center my-4 select-model-prompt">
    <%= render partial: 'select_model'%>
  </div>
  <div class="form-inline parameter parameter-list">
    <%= render partial: 'parameter'%>
  </div>
  <div class="form-inline config-api">
    <div class="form-inline d-flex align-items-center my-4 application-domain">
      <label class="me-3 form-label" style="width: 300px;" for="domain">Description</label>
      <div class="w-100">
      <%= f.text_area :description,
        class: 'form-control',
        :value => @prompt.present? ? @prompt.description : "",
        placeholder: 'Enter description', rows: 3 %>
      </div>
    </div>
    <div class="form-inline d-flex align-items-center my-4 application-domain prompt">
      <label class="me-3 form-label" style="width: 300px;" for="domain">Application Domain</label>
      <div class="w-100">
        <%= text_field_tag'', @prompt.present? ? @prompt.application_domain : '', class: 'form-control disable-fields', disabled: true %>
      </div>
    </div>
    <div class="form-inline d-flex align-items-center">
      <label class="me-3 form-label" style="width: 300px;" for="api-endpoint">Application endpoint name <span style="color: red">*</span></label>
        <div class="w-100">
          <%= f.text_field :endpoint_name,
            class: "form-control",
            id: "endpoint_name",
            maxlength: "255",
            :value => @prompt.present? ? @prompt.endpoint_name : "",
            :required => true
          %>
          <div class="error-endpoint_name-content" style="color: red"></div>
        </div>
    </div>
    <div class="form-inline d-flex align-items-center my-4 prompt">
      <label class="me-3 form-label" style="width: 300px;" for="api-url">API endpoint URL</label>
        <%= f.text_field :endpoint_url,
          class: "form-control disable-fields",
          id: "endpoint_url",
          :value => @prompt.present? ? @prompt.endpoint_url : "",
          placeholder: 'API Endpoint URL',
          data: {
            domain: ENV['DOMAIN_API']
          }
        %>
        <button type="button" class="copy-url__endpoint me-2 btn-link btn p-0"
          data-message-copy="copy endpoint URL"
        >
          <i class="far fa-copy color-copy"></i>
        </button>
    </div>
    <div class="d-flex align-items-center justify-content-center my-3">
      <button id="test-prompt" data-action="test-prompt" class="btn btn-primary mx-2" type="button" <%= @prompt.present? ? ' ' : 'disable' %>>Test1</button>
      <button id="save-prompt" data-action="save" class="btn btn-primary mx-2 <%= user_project_role ? 'disabled' : '' %>">Save</button>
    </div>
  </div>
<% end %>

<script>
  window.addEventListener("DOMContentLoaded", (event) => {
  $(document).on('change', '.select-api', function(e) {
    const api_id = $(this).val();
    const action = $(".prompt-form")?.attr('action')

    $.ajax({
        url: action,
        data: {
          ai_api_id: api_id
        },
        beforeSend: (xhr) => {
          const csrfToken = document.querySelector("meta[name='csrf-token']").content;
          xhr.setRequestHeader('X-CSRF-Token', csrfToken);
        },
        type: 'GET',
        dataType: 'script',
      });
  })

  window.scroll({
    top: 0,
    left: 0,
    behavior: "smooth",
  });

  function handle_validate() {
    if ($("#prompt_name").val() == '') {
      $(".error-name-content").removeClass("d-none")
    } else {
      $(".error-name-content").addClass("d-none")
    }
    if ($("#endpoint_name").val() == '') {
      $(".error-endpoint_name-content").removeClass("d-none")
    } else {
      $(".error-endpoint_name-content").addClass("d-none")
    }
  }
});
</script>
