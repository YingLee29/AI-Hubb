<% breadcrumb :projects %>
<% provide(:title, t("views.project.pm")) %>
<div class="container-xxl flex-grow-1 container-p-y pt-5" data-controller="project">
  <div class="d-flex justify-content-between align-items-center">
    <div class="title">
      <h4 class="mb-3 fw-6"><%= t("views.project.pm") %></h4>
    </div>
  </div>
    <% if check_admin %>
      <div class="mb-3 text-end text-right">
          <button class="btn btn-primary create-project-btn" data-action="<%= t("views.project.modal.create_project") %>">
            <i class="fa fa-plus mr-2"></i>
            <%= t("views.project.modal.create_project") %>
          </button>
      </div>
    <% end %>
    <div class="mb-3">
      <%= search_form_for @search, class: 'd-flex align-content-center justify-content-between', id: 'search-project' do |f| %>
      <div class="w-100">
        <div class="form-group has-search">
          <span class="fa fa-search form-control-feedback"></span>
          <input class="form-control" type="text" name="keyword" id="user-keyword" autocomplete="off"
            value='<%= @keyword if @keyword.present? %>' placeholder='<%= t("views.project.table.project_name") %>'>
        </div>
      </div>
      <% end %>
    </div>
    <div style="overflow-x: auto;">
      <table class="table table-hover table-custom overflow-auto table-bordered">
        <thead>
          <tr class="text-center">
            <th class="text-center" style="width: 10%">No</th>
            <th class="text-center" style="width: 25%"><%= t("views.project.table.project_name") %></th>
            <th class="text-center" style="width: 25%"><%= t("views.project.table.applicationd_domain") %></th>
            <th class="text-center" style="width: 30%"><%= t("views.project.table.description") %></th>
            <th class="text-center" style="width: 10%"><%= t("views.project.table.action") %></th>
          </tr>
        </thead>
        <tbody class="table-border-bottom-0" id="list-services">
          <% if @projects.present? %>
            <%= render partial: 'list'%>
          <% else %>
            <tr class="text-center">
              <td colspan="7"><%= t("views.project.table.no_data") %></td>
            </tr>
          <% end%>
        </tbody>
      </table>
    </div>

  <div class="card-footer <%= @prompts.present? ? 'block' : 'none' %>">
    <div class="demo-inline-spacing d-flex justify-content-end">
      <div class="pagination">
        <%= render partial: 'paginate'%>
      </div>
    </div>
  </div>


  <div class="modal fade" id="createProject" tabindex="-1" data-create-success="<%= t("views.message.create_successfully") %>" data-update-success="<%= t("views.message.update_successfully") %>">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="modal-title"><%= t("views.project.modal.edit_project") %></h1>
          <button type="button" id="closeModal" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= form_with url: projects_path,
          method: :post,
          html: { autocomplete: "off" },
          local: true, class: "project-form" do |f| %>
          <div class="modal-body">
            <div class="mb-1 project_name" data-validate-mess="<%= t("views.project.modal.project_name_validate")%>">
              <label><%= t("views.project.table.project_name") %> <span class="text-danger">*</span> </label>
              <%= f.text_field :name, maxlength: "255", class: 'form-control', placeholder: t("views.project.table.project_name") %>
              <div><span class="error-name-content" style="color: red"></span></div>
            </div>
            <div class="my-3 application_domain" data-validate-mess="<%= t("views.project.modal.application_content")%>">
              <%= f.label :application_domain, t("views.project.table.applicationd_domain") %> <span class="text-danger">*</span>
              <%= f.text_field :application_domain, class: 'form-control', maxLength: 255,placeholder: t("views.project.table.applicationd_domain") %>
              <div><span class="error-application-content" style="color: red"></span></div>
            </div>
            <div class="my-3">
              <%= f.label :ip_white_list, t("views.project.modal.ip_whitelist") %>
              <%= f.text_field :ip_white_list, class: 'form-control ip-white-list', maxLength: 255, placeholder: t("views.project.modal.ip_whitelist") %>
            </div>
            <div class="my-3">
              <%= f.label :description, t("views.project.table.description") %>
              <%= f.text_field :description, maxlength: "255", class: 'form-control',placeholder: t("views.project.table.description") %>
            </div>
            <div class="select-user-project">
              <%= render partial: 'select_user' %>
            </div>
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" data-bs-dismiss="modal" id="closeModal"><%= t("views.button.close") %></button>
            <button type="submit" class="btn btn-primary submit-project-form"><%= t("views.button.save") %></button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div id="toastsContainerTopRight" class="toasts-top-right fixed toast-custom d-none">
  <div class="bs-toast toast toast-ex animate__animated my-2" role="alert" aria-live="assertive" aria-atomic="true"
    data-bs-delay="2000">
    <div class="toast-header d-flex justify-content-start">
      <div class="toast-body"></div>
    </div>
  </div>
</div>
