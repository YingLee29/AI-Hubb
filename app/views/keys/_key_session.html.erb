<div class="row-custom border py-4">
  <div class="title-table">API keys</div>
    <div class ="d-flex justify-content-end my-2">
      <button class="btn btn-primary <%= user_project_role ? 'disabled' : '' %>" data-bs-toggle="modal" data-bs-target="#addKey">
        <i class="fa fa-plus mr-2"></i>
        <%= t("views.prompt.key.add_key")%>
      </button>
    </div>
    <div class="col-12">
      <div class="table-responsive p-0 key-list">
        <%= render 'keys/list', keys: keys %>
      </div>
    </div>
</div>

<%= render 'keys/create_key', form: Key.new(prompt_id: prompt.id) %>
<%= render 'shared/confirm_modal', model_id: 'copy_model', header: 'Confirm', body: 'You can only copy or download the Api key once. Do you still want to continue?' %>
<%= render 'shared/confirm_modal', model_id: 'delete_model', header: 'Confirm', body: 'Do you want to delete this key now?' %>

<script type="text/javascript">
  window.addEventListener("DOMContentLoaded", (event) => {
    $('#addKey .btn-close').click(function() {
      $('#new_key')[0].reset();
      $('.needs-validation').removeClass('was-validated');
    });
    $(document).on("hidden.bs.modal","#addKey", function () {
      $('#new_key')[0].reset();
      $('.needs-validation').removeClass('was-validated');
    })
  });
</script>
