<div class="container-xxl content container-p-y" style="height: 100vh">
  <div class="content-position">
    <div class="error-number" style="color: #ffc107; margin-right: 2rem">
      404
    </div>
    <div>
      <h2 class="mb-2 mx-2">
        <i class="fas fa-exclamation-triangle" style="color: #ffc107"></i>
        Page not found
      </h2>
      <p class="my-4 mx-2">Oops! The requested URL was not found on this server.</p>
      <%= link_to 'Back to home', root_path,class:"error-link bg-warning"  %>
    </div>
  </div>
</div>
