<!DOCTYPE html>
<html>
  <head>
    <title><%= yield(:title) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous">
    </script>
  </head>

  <body>
    <div class="layout-content" data-controller="bases">
      <div class="position-absolute z-index-999 alert-center flash_wrapper">
        <% if alert.present? %>
          <div class=" mt-4 d-flex justify-content-center hidden-flash">
            <div class="alert alert-warning-devise alert-dismissible" role="alert">
              <p class="alert mb-0"><%= alert %></p>
            </div>
          </div>
        <% end %>
      </div>
      <%= yield %>
    </div>
  </body>
</html>
