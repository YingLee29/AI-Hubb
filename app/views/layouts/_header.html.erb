<div id="toastsContainerTopRight" class="toasts-top-right fixed toast-custom d-none">
  <div class="bs-toast toast toast-ex animate__animated my-2" role="alert" aria-live="assertive" aria-atomic="true"
    data-bs-delay="2000">
    <div class="toast-header d-flex justify-content-start">
      <div class="toast-body"></div>
    </div>
  </div>
</div>

<div class="modal fade" id="changeLanguage" tabindex="-1" aria-labelledby="listModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="listModalLabel">Change Language</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          This action reloads the page. All of inputted values will be cleared. Do you want to continue?
        </div>
        <div class="modal-footer justify-content-center">
          <button type="button" class="btn btn-secondary mx-2" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary mx-2 confirm-change_language" data-bs-dismiss="modal">Ok</button>
        </div>
      </div>
    </div>
  </div>
<script>
  window.addEventListener("DOMContentLoaded", (event) => {

    function handleError(mess) {
      $("#toastsContainerTopRight").removeClass("d-none");
      $(".toast").toast({ delay: 2000 });
      $(".toast").toast("show");
      $(".toast").addClass("bg-danger");
      $(".toast").addClass("top-0 end-0");
      $(".toast-body").html(mess);
    }

    $("#list-service__common").on("click", function (e) {
      const service_id = '<%= ENV["SERVICE_ID"] %>'
      const base_url = '<%= ENV["Local_ID_BASE_URL"] %>'
      const client_id = '<%= ENV["CLIENT_ID"] %>'
      const endPoint = "api/v1/oauth2/authorize"

      // get data form session when work flow login and save on session token_id, uid (user data)
      const user_id = "<%= session['x_user_id'] %>"
      const token_id = "<%= session[:id_token] %>"

      const parentElementLocal = document.getElementById('show-services-Local__common');
      parentElementLocal.innerHTML = '';
      const parentElement = document.getElementById('show-services__common');
      parentElement.innerHTML = '';

      function createServiceElement(item, index, isDefault) {
        const serviceBox = document.createElement('div');
        const serviceBoxChild = document.createElement('div');
        const serviceImage = document.createElement('img');
        const serviceName = document.createElement('a');
        const urlDomain = item.domain || 'about:blank';
        let url = base_url;
        if (urlDomain != base_url){
          url = `${base_url}/${endPoint}?service_id=${item.public_uid}&client_id=${client_id}&response_type=code`;
        }
        serviceBox.classList.add('col-md-4', 'mb-4');
        serviceBox.addEventListener('click', function() {
          console.log("isDefault", isDefault);
          const link = isDefault ? url : urlDomain;
          window.open(link, '_blank');
        });

        serviceImage.classList.add('header-image__service', 'img-fluid', 'pt-2');
        serviceImage.setAttribute('ltt', 'service image');
        serviceImage.setAttribute('src', `${base_url}${item.logo_url}`);

        serviceName.textContent = item.name;
        serviceName.classList.add('service-name__header', 'fitc', 'font-0875', 'text-center', 'py-2', 'text-truncate');
        serviceName.setAttribute('target', '_blank');
        serviceName.setAttribute('href', isDefault ? url : urlDomain)

        serviceBoxChild.appendChild(serviceImage);
        serviceBoxChild.appendChild(serviceName);

        serviceBoxChild.classList.add('item-service__common');
        serviceBox.appendChild(serviceBoxChild);

        return serviceBox;
      }

      function renderServices(data = [], isDefault = true) {
        const dataList = isDefault
          ? document.getElementById('show-services-Local__common')
          : document.getElementById('show-services__common');

        data.forEach((item, index) => {
          const serviceBox = createServiceElement(item, index, isDefault);
          dataList.appendChild(serviceBox);
        });
      }

      $(document).ready(function() {
        $.ajax({
          url: `${base_url}/api/v1/services?id_token=${token_id}&service_id=${service_id}`,
          type: 'GET',
          dataType: 'json',
          beforeSend: function(xhr) {
            const csrfToken = document.querySelector("meta[name='csrf-token']").content;
            xhr.setRequestHeader('X-CSRF-Token', csrfToken);
            xhr.setRequestHeader('X-User-Id', user_id);
          },
        })
        .done(function(res) {
          $('.header-common').removeClass('d-none');
          const listServiceLocal = res?.services || [];
          const otherServices = res?.other_services || [];
          renderServices(listServiceLocal);
          renderServices(otherServices, false);
        })
        .fail(function(error) {
          $('.header-common').addClass('d-none');
          handleError(`${error.statusText}!`);
        });
      });
    });
    //handle change language
    const language = [
      {
        label: "English",
        value: "en",
      },
      {
        label: "Japanese",
        value: "ja",
      },
    ];
    function handleChangeLanguage(lan) {
      $.ajax({
        url: "/language",
        type: "POST",
        data_type: "json",
        beforeSend: (xhr) => {
          const csrfToken = document.querySelector(
            "meta[name='csrf-token']"
          ).content;
          xhr.setRequestHeader("X-CSRF-Token", csrfToken);
        },
        data: {
          language: lan,
        },
      }).done(function (data) {
          window.location.reload();
        })
        .fail(function (e) {
          console.log(e);
        });
    }
    $(document).on('click', '#multiChoiceLang .language-active', function(e) {
      e.preventDefault();
      const thisController = $(".controller-action").data('controller');
      const selectValue = $(this).data("value");
      const languageTarget = language.find((lan) => lan.value == selectValue)?.value || "en";
      if (thisController) {
        $("#changeLanguage").modal('show');
        $("#changeLanguage").data('language', languageTarget)
      } else {
        handleChangeLanguage(languageTarget);
      }
    })

    $(document).on('click', '.confirm-change_language', function(e) {
      const lang = $("#changeLanguage").data('language')
      handleChangeLanguage(lang)
    })
  });
</script>
