<!DOCTYPE html>
<html>
  <head>
    <title><%= yield(:title) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous">
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/markdown-it/13.0.1/markdown-it.min.js" integrity="sha512-SYfDUYPg5xspsG6OOpXU366G8SZsdHOhqk/icdrYJ2E/WKZxPxze7d2HD3AyXpT7U22PZ5y74xRpqZ6A2bJ+kQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.3.1/styles/default.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.3.1/highlight.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/highlightjs-copy@1.0.4/dist/highlightjs-copy.min.css" rel="stylesheet">
  </head>

  <body>
    <%= render "layouts/header" %>
    <div class="layout-content" data-controller="bases">
      <div class="position-absolute z-index-999 alert-right flash_wrapper">
        <% flash.each do |message_type, message| %>
          <div class="alert alert-success hidden-flash"><%= message %></div>
        <% end %>
      </div>
      <%= render "layouts/breadcrumb" %>
      <%= yield %>
    </div>
    <%= render "layouts/footer" %>
  </body>
</html>
